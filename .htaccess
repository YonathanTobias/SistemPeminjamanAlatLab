<IfModule mod_rewrite.c>
    RewriteEngine On
    Options -Indexes

    # 1. BLOKIR AKSES KE FILE SENSITIF (.env, .git, artisan, composer, sql, log, dll)
    <FilesMatch "^\.env|^\.git|composer\.(json|lock)|package\.(json|lock)|artisan|web\.config|\.(sql|log|md|yml|yaml|ini|sh|bak|swp|dist|env.*)$">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # 2. BLOKIR AKSES LANGSUNG KE DIREKTORI INTI LARAVEL (app, bootstrap, config, database, resources, routes, storage, vendor)
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/.*)?$ - [F,L,NC]

    # 3. REDIRECT SELURUH TRAFFIC DENGAN AMAN KE FOLDER /public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
